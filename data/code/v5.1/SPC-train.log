 30, 'Sadness': 0, 'Surprise': 5, 'Love': 30, 'Boredom': 0, 'Neutral': 35}, 'text': "I don't have to think too much about what I'm ordering, I know I'll like it."}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 35, 'Sadness': 0, 'Surprise': 5, 'Love': 30, 'Boredom': 0, 'Neutral': 30}, 'text': "I know, it's the best! What's your favorite food?"}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 40, 'Sadness': 0, 'Surprise': 5, 'Love': 35, 'Boredom': 0, 'Neutral': 20}, 'text': 'I love pizza, I could eat it every day.'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 40, 'Sadness': 0, 'Surprise': 0, 'Love': 40, 'Boredom': 0, 'Neutral': 20}, 'text': 'Me too! I love the variety of toppings you can get.'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 30, 'Sadness': 0, 'Surprise': 10, 'Love': 40, 'Boredom': 0, 'Neutral': 20}, 'text': 'And the sauce, I could drink that stuff.'}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 35, 'Sadness': 0, 'Surprise': 5, 'Love': 40, 'Boredom': 0, 'Neutral': 20}, 'text': 'Same here, I love a good sauce.'}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 10, 'Joy': 40, 'Sadness': 0, 'Surprise': 5, 'Love': 30, 'Boredom': 0, 'Neutral': 15}, 'text': "I'm so glad we agree, I was worried you wouldn't like pizza."}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 5, 'Joy': 40, 'Sadness': 0, 'Surprise': 5, 'Love': 45, 'Boredom': 0, 'Neutral': 5}, 'text': "Of course I do, it's the best!"}}, {'role': 'participant_2', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy': 40, 'Sadness': 0, 'Surprise': 5, 'Love': 40, 'Boredom': 0, 'Neutral': 15}, 'text': "I'm so glad, now we can be pizza buddies!"}}, {'role': 'participant_1', 'content': {'emotion_scores': {'Anger': 0, 'Fear': 0, 'Joy